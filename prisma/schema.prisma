generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id                   String       @id @default(cuid())
  name                 String
  slug                 String       @unique
  description          String?
  plan                 String       @default("standard")
  paddleProductId      String?      @unique
  paddlePriceId        String?
  maxActivations       Int          @default(3)
  active               Boolean      @default(true)

  // ECDSA P-256 key pair
  signatureAlgorithm   String       @default("ecdsa-p256")
  privateKeyEncrypted  String?
  publicKey            String?
  publicKeyFingerprint String?      @unique

  // Per-product support contact, substituted into the {{supportEmail}}
  // placeholder. Falls back to env.SUPPORT_EMAIL, then to a hard-coded
  // Resend dev address, when this is null.
  supportEmail         String?

  licenses             LicenseKey[]
  orders               Order[]
  templates            ProductEmailTemplate[]
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
}

model ProductEmailTemplate {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Simplified language code: "en" "zh" "ja" "de" — no region suffix.
  // Paddle's BCP-47 strings like "zh-CN" are matched by `-` prefix.
  locale      String
  // Admin-facing friendly name: "English" / "简体中文" / "日本語".
  displayName String
  // Exactly one default per product, currently always `en`. Enforced in
  // application code (no DB-level partial unique constraint).
  isDefault   Boolean  @default(false)
  // Optional per-template from address. Falls back to Product.resendFromAddress.
  fromAddress String?
  subject     String
  bodyHtml    String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([productId, locale])
  @@index([productId])
}

model LicenseKey {
  id             String       @id @default(cuid())
  keyHash        String       @unique
  productId      String
  product        Product      @relation(fields: [productId], references: [id])
  orderId        String?
  order          Order?       @relation(fields: [orderId], references: [id])
  maxActivations Int
  revoked        Boolean      @default(false)
  revokedAt      DateTime?
  revokedReason  String?
  notes          String?

  emailedAt      DateTime?
  emailError     String?
  emailAttempts  Int          @default(0)

  activations    Activation[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([productId])
  @@index([orderId])
}

model Activation {
  id            String     @id @default(cuid())
  licenseKeyId  String
  licenseKey    LicenseKey @relation(fields: [licenseKeyId], references: [id], onDelete: Cascade)
  fingerprint   String
  label         String?
  ipAddress     String?
  userAgent     String?
  lastCheckedAt DateTime   @default(now())
  createdAt     DateTime   @default(now())

  @@unique([licenseKeyId, fingerprint])
  @@index([licenseKeyId])
}

model Order {
  id                  String       @id @default(cuid())
  paddleTransactionId String       @unique
  paddleCustomerId    String?
  paddleEmail         String?
  // BCP-47 locale captured from Paddle (e.g. "zh-CN"). Used at email-send
  // time to pick a ProductEmailTemplate by language-code prefix.
  locale              String?
  productId           String?
  product             Product?     @relation(fields: [productId], references: [id])
  amount              Int
  currency            String
  status              String
  rawPayload          Json
  licenses            LicenseKey[]
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([paddleEmail])
}

model WebhookEvent {
  id            String   @id @default(cuid())
  paddleEventId String   @unique
  eventType     String
  processed     Boolean  @default(false)
  payload       Json
  error         String?
  receivedAt    DateTime @default(now())
}