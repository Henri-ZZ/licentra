generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id                   String       @id @default(nanoid(10))
  name                 String
  slug                 String       @unique
  description          String?
  paddleProductId      String?      @unique
  maxActivations       Int          @default(3)
  // 签名有效时长（秒）。客户端用公钥验签后，若签名时间距今超过此时长，
  // 需重新联网验证。默认 86400 = 24 小时。
  signatureTtlSeconds  Int          @default(86400)
  active               Boolean      @default(true)

  // ECDSA P-256 key pair
  privateKeyEncrypted  String?
  publicKey            String?
  publicKeyFingerprint String?      @unique

  // Per-product support contact, substituted into the {{supportEmail}}
  // placeholder. Falls back to env.SUPPORT_EMAIL, then to a hard-coded
  // Resend dev address, when this is null.
  supportEmail         String?

  licenses             License[]
  orders               Order[]
  templates            ProductEmailTemplate[]
  priceTiers           ProductPriceTier[]
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
}

model ProductPriceTier {
  id            String   @id @default(nanoid(10))
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Free-text plan name shown in dashboards and signed into LicensePayload.
  // 1–40 chars. Unique per product.
  plan          String
  // Paddle price ID (pri_xxx). Required so the admin has recorded the
  // Paddle-side reference; the webhook currently doesn't match on it (see
  // docs/plans/price-tiers.md for why and when that changes).
  paddlePriceId String?
  // Snapshot-style duration. null = lifetime. **Immutable** post-creation:
  // changing this for an existing tier would silently shift expires_at on
  // every license already issued under it.
  expiresInDays Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  licenses      License[]

  @@unique([productId, plan])
  @@unique([productId, paddlePriceId])
  @@index([productId])
}

model ProductEmailTemplate {
  id          String   @id @default(nanoid(10))
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Simplified language code: "en" "zh" "ja" "de" — no region suffix.
  // Paddle's BCP-47 strings like "zh-CN" are matched by `-` prefix.
  locale      String
  // Admin-facing friendly name: "English" / "简体中文" / "日本語".
  displayName String
  // Exactly one default per product, currently always `en`. Enforced in
  // application code (no DB-level partial unique constraint).
  isDefault   Boolean  @default(false)
  // Optional per-template from address. Falls back to Product.resendFromAddress.
  fromAddress String?
  // Optional display name for the from address (e.g. "Licentra"). When set,
  // the mail is sent as "Licentra <fromAddress>"; otherwise just fromAddress.
  fromName    String?
  subject     String
  bodyHtml    String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([productId, locale])
  @@index([productId])
}

model License {
  // ------------------------------------------------------------------
  // License Identity vs License Key (see docs/licentra-offline-migration-spec.md)
  //
  // `id` is the PERMANENT License Identity. It never changes: not on key
  // rotation, device changes, or migration. Clients see it as
  // payload.license_id and as certificate.license_id.
  //
  // `keyHash` is the hash of the CURRENT credential (License Key). It is
  // NOT the identity — rotating a key updates keyHash in place on this
  // row (see POST /api/licenses/[id]/resend-email), keeping id, device
  // activations and migration fields untouched.
  // ------------------------------------------------------------------
  id             String       @id @default(nanoid(10))
  keyHash        String       @unique
  productId      String
  product        Product      @relation(fields: [productId], references: [id])
  orderId        String?
  order          Order?       @relation(fields: [orderId], references: [id])
  // Snapshot of the PriceTier at issue time. Null for licenses issued
  // before the PriceTier migration ran. plan + expiresAt are denormalised
  // onto the row for hot-path read efficiency (validate/activate/check-in).
  tierId         String?
  tier           ProductPriceTier? @relation(fields: [tierId], references: [id])
  plan           String?
  expiresAt      DateTime?
  maxActivations Int
  revoked        Boolean      @default(false)
  revokedAt      DateTime?
  revokedReason  String?

  // --- Customer contact, self-contained on the License (mirrored from
  // Order.paddleEmail / Paddle customer_id at issue time) ---
  customerId      String?
  email           String?

  emailedAt      DateTime?
  emailError     String?
  emailAttempts  Int          @default(0)

  activations    Activation[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([productId])
  @@index([orderId])
  @@index([tierId])

  // Physical table name preserved from the pre-refactor schema so `db push`
  // does not drop/recreate the table (which would lose license data).
  @@map("LicenseKey")
}

model Activation {
  id            String     @id @default(nanoid(10))
  licenseId     String     @map("licenseKeyId")
  license       License    @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  fingerprint   String
  label         String?
  ipAddress     String?
  // Compact browser summary (e.g. "Chrome 126 · macOS") parsed from the
  // User-Agent at activation time. The raw UA string is NOT stored.
  browser       String?
  lastCheckedAt DateTime   @default(now())
  createdAt     DateTime   @default(now())

  @@unique([licenseId, fingerprint])
  @@index([licenseId])
}

/// Licentra-level Ed25519 signing keys used to produce Signed License
/// Certificates and migration exports (spec §8 / §9). Independent from
/// per-product ECDSA keys used to sign LicensePayloads. `kid` travels
/// inside every certificate so destination systems pick the right public
/// key; rotated keys are retired (not deleted) so previously issued
/// certificates stay verifiable.
model SigningKey {
  id                  String    @id @default(nanoid(10))
  // e.g. "licentra-2026-08". Unique; rotated keys keep their kid.
  kid                 String    @unique
  algorithm           String    @default("Ed25519")
  privateKeyEncrypted String
  publicKey           String
  active              Boolean   @default(true)
  createdAt           DateTime  @default(now())
  retiredAt           DateTime?

  @@index([active])
}

/// Immutable audit trail for license lifecycle / migration operations
/// (spec §26). Never log plaintext License Keys or private keys here.
model AuditEvent {
  id                String   @id @default(nanoid(10))
  // e.g. license.key_rotated | license.status_changed |
  //      license.migration_exported
  eventType         String
  licenseId         String?
  sourceSystem      String?
  sourceLicenseId   String?
  destinationSystem String?
  migrationId       String?
  actor             String?
  metadata          Json?
  createdAt         DateTime @default(now())

  @@index([licenseId])
  @@index([eventType])
  @@index([createdAt])
}

model Order {
  id                  String   @id @default(nanoid(10))
  paddleTransactionId String   @unique
  paddleEmail         String?
  // BCP-47 locale captured from Paddle (e.g. "zh-CN"). Used at email-send
  // time to pick a ProductEmailTemplate by language-code prefix.
  locale              String?
  productId           String?
  product             Product? @relation(fields: [productId], references: [id])
  amount              Int
  currency            String
  status              String
  licenses            License[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([paddleEmail])
}
