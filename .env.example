# ============================================
# Licentra — production environment variables
# ============================================
# This file is gitignored. For local dev, copy from .env.example.
# For Vercel deployment, set these in:
#   Project Settings → Environment Variables
# Each variable must be set for all three environments (Production /
# Preview / Development) as needed — Vercel will inject them at build
# and runtime.

# --- Database (Neon Postgres pooled connection) ---
# Use the POOLED connection string (the one with -pooler in the host)
# because Vercel serverless functions need short-lived transactions.
DATABASE_URL="postgresql://USER:PASS@ep-xxx-pooler.region.aws.neon.tech/DB?sslmode=require"

# --- Dashboard login (single user, hardcoded) ---
# Change these in production. Login is `verifyCredentials(env.ADMIN_EMAIL, env.ADMIN_PASSWORD)`.
ADMIN_EMAIL="henrizhang@henri.ren"
ADMIN_PASSWORD="*********"

# --- Dashboard session signing ---
# HS256 JWT secret. Generate with: openssl rand -hex 32
AUTH_JWT_SECRET=""

# --- License signing ---
# AES-256-GCM master key used to encrypt product private keys at rest.
# **CRITICAL** — this key decrypts every Product's ECDSA private key.
# Generate with: openssl rand -hex 32
# Note: changing this invalidates all stored Product private keys
# (you would need to regenerate every product's signing key pair).
LICENSE_MASTER_KEY=""

# --- Paddle Billing ---
# Notification secret from Paddle Dashboard → Developer tools → Notifications.
PADDLE_WEBHOOK_SECRET="xxxxxxx"

# --- Resend (transactional email) ---
# Real API key (NOT starting with "re_dev" — that triggers dev stub mode).
RESEND_API_KEY=""

# --- App ---
# The deployed origin. Used for absolute URLs in emails / callbacks.
NEXT_PUBLIC_APP_URL="https://YOUR-DOMAIN.vercel.app"
